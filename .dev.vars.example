# Local development secrets for `npm run dev:full` (wrangler pages dev).
# Copy this file to `.dev.vars` (which is gitignored) and fill in real values.
# These only affect your LOCAL machine — production uses the Cloudflare dashboard
# secrets, which are completely separate.

# JSON map of passcode -> the single access label it unlocks. Type one of these
# passcodes on the local login screen to view whatever that label can access.
#
# The LABEL (the value) must appear in the sheet's `access` column, or login
# succeeds but the gallery renders empty -- there is no error, just no images.
# The live labels are: admin (all images), user1, user2.
#
# The PASSCODE (the key) is local-only and should NOT match production. It is
# just a lookup key; behaviour is decided entirely by the label, so reusing the
# real passcodes buys no extra fidelity while copying production secrets onto
# disk. Use throwaway strings like these.
GALLERY_PASSCODES={"local-admin":"admin","local-user1":"user1","local-user2":"user2"}

# Any random string. Only signs local session cookies; need not match production.
SESSION_SECRET=local-only-change-me

# The CURRENT (post-rotation) Google Apps Script /exec URL, so local data loads.
SHEET_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_NEW_DEPLOYMENT_ID/exec
